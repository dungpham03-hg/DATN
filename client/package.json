{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend cho ứng dụng quản lý cuộc họp",
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^5.15.21",
    "@mui/material": "^5.15.21",
    "@react-oauth/google": "^0.8.1",
    "ajv": "^8.12.0",
    "ajv-keywords": "^5.1.0",
    "axios": "^1.6.2",
    "date-fns": "^2.30.0",
    "emoji-picker-react": "^4.12.2",
    "file-saver": "^2.0.5",
    "formik": "^2.4.5",
    "http-proxy-middleware": "^2.0.6",
    "moment": "^2.30.1",
    "notistack": "^3.0.2",
    "quill": "^2.0.3",
    "react": "^18.3.1",
    "react-big-calendar": "^1.19.3",
    "react-calendar": "^4.8.0",
    "react-datepicker": "^4.25.0",
    "react-dom": "^18.3.1",
    "react-icons": "^4.12.0",
    "react-modal": "^3.16.1",
    "react-quill": "^2.0.0",
    "react-router-dom": "^6.8.1",
    "react-select": "^5.8.0",
    "recharts": "^2.15.4",
    "schema-utils": "^4.2.0",
    "socket.io-client": "^4.7.2",
    "xlsx": "^0.18.5",
    "yup": "^1.4.0"
  },
  "scripts": {
    "start": "set DANGEROUSLY_DISABLE_HOST_CHECK=true && react-scripts start",
    "build": "npm run build:production",
    "build:production": "cross-env NODE_ENV=production GENERATE_SOURCEMAP=false INLINE_RUNTIME_CHUNK=false react-scripts build",
    "test": "react-scripts test",
    "test:coverage": "react-scripts test --coverage --watchAll=false",
    "test:ci": "react-scripts test --coverage --watchAll=false --ci",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test:e2e": "start-server-and-test start http://localhost:3000 cypress:run",
    "test:e2e:open": "start-server-and-test start http://localhost:3000 cypress:open",
    "lint": "eslint src --ext .js,.jsx --fix",
    "lint:check": "eslint src --ext .js,.jsx",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/index.js",
      "!src/setupTests.js",
      "!src/setupProxy.js",
      "!src/**/*.test.{js,jsx}",
      "!src/**/__tests__/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 60,
        "lines": 60,
        "statements": 60
      }
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(axios)/)"
    ],
    "moduleNameMapper": {
      "^axios$": "axios/dist/node/axios.cjs"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "homepage": ".",
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.4.3",
    "cross-env": "^7.0.3",
    "cypress": "^13.6.0",
    "eslint": "^8.57.0",
    "jest-environment-jsdom": "^29.7.0",
    "lighthouse-cli": "^0.1.2",
    "msw": "^1.3.2",
    "react-scripts": "^5.0.1",
    "start-server-and-test": "^2.0.3",
    "webpack-bundle-analyzer": "^4.10.2"
  }
}
