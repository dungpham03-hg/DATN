# Node & general
node_modules/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS/Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Build outputs
client/build/
client/coverage/
server/coverage/
apps/**/build/
apps/**/coverage/

# Docker/Compose local artifacts
*.pid
*.seed
.env.local
.env.development
.env.test

# Office temp files
~$*
~WRL*.tmp

# Archives & binaries
*.zip
*.tar
*.tar.gz
*.7z
*.rar

# Project docs (exclude from commit)
docs/**
*.md
!README.md  # Allow root README

# Images and diagrams (if not needed)
*.drawio
*.png
*.jpg
*.jpeg
*.gif

# Uploads/runtime data (should be on storage/S3)
server/uploads/

# Test artifacts
coverage/
reports/

# Misc
*.bak
*.tmp
tmp/

# Allow committing setup docs (override previous ignore rules)
!docs/setup/
!docs/setup/*.md
!docs/setup/**/*.md

# Do not track environment files in server
server/.env