# ======================
# ENVIRONMENT CONFIGURATION
# ======================
# Copy file này thành .env và điều chỉnh theo môi trường

# ======================
# ENVIRONMENT MODE
# ======================
# development | production
NODE_ENV=development

# ======================
# DATABASE
# ======================
# Local Development (MongoDB Local):
MONGODB_URI=mongodb://localhost:27017/meeting_management

# Production (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/meeting_management?retryWrites=true&w=majority

# ======================
# SERVER
# ======================
PORT=5000

# ======================
# JWT SECRET
# ======================
# ⚠️ QUAN TRỌNG: Thay đổi secret này trong production!
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long

# ======================
# FRONTEND URLs
# ======================
# Local Development:
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
DOMAIN_URL=http://localhost:3000

# VPS Production (uncomment và thay đổi domain):
# CLIENT_URL=https://your-domain.com
# FRONTEND_URL=https://your-domain.com
# DOMAIN_URL=https://your-domain.com

# ======================
# FILE UPLOAD
# ======================
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads/

# ======================
# EMAIL (Optional)
# ======================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# ======================
# MICROSOFT OAUTH (Optional)
# ======================
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Local:
MICROSOFT_CALLBACK_URL=http://localhost:5000/api/auth/microsoft/callback
# Production:
# MICROSOFT_CALLBACK_URL=https://your-domain.com/api/auth/microsoft/callback
MICROSOFT_TENANT_ID=common

# ======================
# DOMAIN AUTH (Optional)
# ======================
ENABLE_DOMAIN_LOGIN=false
REQUIRE_DOMAIN_VALIDATION=false
