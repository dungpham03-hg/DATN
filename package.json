{
  "name": "meeting-management-app",
  "version": "1.0.0",
  "description": "Ứng dụng quản lý cuộc họp với quy trình kiểm thử toàn diện",
  "scripts": {
    "install:all": "npm run install:client && npm run install:server",
    "install:client": "cd client && npm install",
    "install:server": "cd server && npm install",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "cd client && npm start",
    "dev:server": "cd server && npm run dev",
    "build": "npm run build:client",
    "build:client": "cd client && npm run build",
    "start": "npm run start:server",
    "start:server": "cd server && npm start",
    "test": "npm run test:server && npm run test:client",
    "test:client": "cd client && npm run test:ci",
    "test:server": "cd server && npm run test:ci",
    "test:coverage": "npm run test:coverage:server && npm run test:coverage:client",
    "test:coverage:client": "cd client && npm run test:coverage",
    "test:coverage:server": "cd server && npm run test:coverage",
    "test:e2e": "cd tests/e2e && npm run test:e2e",
    "test:e2e:open": "cd tests/e2e && npm run test:e2e:open",
    "test:docker": "docker-compose -f deployment/docker/docker-compose.test.yml up --build --abort-on-container-exit",
    "lint": "npm run lint:client && npm run lint:server",
    "lint:client": "cd client && npm run lint",
    "lint:server": "cd server && npm run lint",
    "lint:fix": "npm run lint:fix:client && npm run lint:fix:server",
    "lint:fix:client": "cd client && npm run lint:fix",
    "lint:fix:server": "cd server && npm run lint:fix",
    "docker:build": "docker-compose -f deployment/docker/docker-compose.yml build",
    "docker:up": "docker-compose -f deployment/docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f deployment/docker/docker-compose.yml down",
    "docker:logs": "docker-compose -f deployment/docker/docker-compose.yml logs -f",
    "docker:prod": "docker-compose -f deployment/docker/docker-compose.prod.yml up -d",
    "deploy": "./deployment/scripts/deploy.sh",
    "setup:vps": "./deployment/scripts/vps-setup.sh",
    "seed": "cd server && npm run seed",
    "clean": "npm run clean:client && npm run clean:server",
    "clean:client": "cd client && rm -rf node_modules build coverage",
    "clean:server": "cd server && rm -rf node_modules coverage",
    "postinstall": "npm run install:all"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/meeting-management-app.git"
  },
  "keywords": [
    "meeting-management",
    "react",
    "nodejs",
    "mongodb",
    "testing",
    "jest",
    "cypress",
    "docker"
  ],
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "private": true
}
